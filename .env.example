# LOCAL / DEVELOPMENT ONLY example configuration.
# Copy to .env for local development. Do not use these credentials in production.

COMPOSE_PROJECT_NAME=deliveryflow

POSTGRES_IMAGE=postgres:16.4-bookworm
POSTGRES_AIRFLOW_PORT=15432
POSTGRES_SOURCE_PORT=15433
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=local-postgres-admin
AIRFLOW_DB_NAME=airflow_metadata
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=local-airflow-password
SOURCE_DB_NAME=logistics_source
SOURCE_DB_USER=source_app
SOURCE_DB_PASSWORD=local-source-password
NESSIE_DB_NAME=nessie_metadata
NESSIE_DB_USER=nessie_app
NESSIE_DB_PASSWORD=local-nessie-password

KAFKA_IMAGE=apache/kafka:3.9.2
KAFKA_HOST_PORT=9092
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLUSTER_ID=ZGVsaXZlcnlmbG93LWthZmthLTAwMDAwMQ
KAFKA_TOPIC_DELIVERY_EVENTS=delivery-events
KAFKA_TOPIC_VEHICLE_TELEMETRY_EVENTS=vehicle-telemetry-events
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
KAFKA_UI_PORT=8083

MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=localminio
MINIO_ROOT_PASSWORD=localminio123
S3_BUCKET=delivery-lakehouse
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
ICEBERG_WAREHOUSE=s3://delivery-lakehouse/warehouse

NESSIE_IMAGE=ghcr.io/projectnessie/nessie:0.107.5
NESSIE_PORT=19120
NESSIE_URI=http://nessie:19120/api/v2
NESSIE_REF=main

SPARK_IMAGE=deliveryflow-spark:3.5.6
SPARK_BASE_IMAGE=apache/spark:3.5.6-java17
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8082
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2
ICEBERG_VERSION=1.11.0
NESSIE_SPARK_EXTENSIONS_VERSION=0.105.3
AWS_SDK_BUNDLE_VERSION=2.29.52

CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9009
CLICKHOUSE_DATABASE=delivery
CLICKHOUSE_USER=delivery_app
CLICKHOUSE_PASSWORD=local-clickhouse-password
FLEET_CLICKHOUSE_DATABASE=fleet

SUPERSET_IMAGE=deliveryflow-superset:4.1.2
SUPERSET_BASE_IMAGE=apache/superset:4.1.2
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=local-superset-secret-key-change-me
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.local
SUPERSET_IMPORT_TIMEOUT_SECONDS=120

AIRFLOW_IMAGE=deliveryflow-airflow:2.10.5-python3.10
AIRFLOW_BASE_IMAGE=apache/airflow:2.10.5-python3.10
AIRFLOW_WEB_PORT=8080
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.local
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=local-airflow-secret-key-change-me

FLINK_IMAGE=deliveryflow-flink:1.20.3
FLINK_BASE_IMAGE=flink:1.20.3-scala_2.12-java11
FLINK_UI_PORT=8081
FLINK_PARALLELISM=1
FLINK_KAFKA_CONNECTOR_VERSION=3.4.0-1.20
FLEET_OVERSPEED_THRESHOLD_KMH=100
FLEET_LOW_FUEL_THRESHOLD_PCT=15
FLEET_ENGINE_TEMPERATURE_THRESHOLD_C=105

PRODUCER_IMAGE=deliveryflow-producer:0.1.0
TOOLING_IMAGE=deliveryflow-tooling:0.1.0
PRODUCER_APP=delivery
PRODUCER_EVENT_COUNT=25
PRODUCER_INTERVAL_SECONDS=0.2
PRODUCER_MODE=both
PRODUCER_BATCH_ROWS=40
PRODUCER_CONTINUOUS=false
PRODUCER_CONTINUOUS_INTERVAL_SECONDS=60
PRODUCER_EVENTS_PER_INTERVAL=10
